@model DevTrackAI.Models.Certification

<div class="card shadow">

    <div class="card-header bg-info text-white">
        <h3>Add Certification</h3>
    </div>

    <div class="card-body">

        <form asp-action="Create">

            <div class="mb-3">
                <label asp-for="CertificationName"></label>
                <input asp-for="CertificationName"
                       class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Provider"></label>
                <input asp-for="Provider"
                       class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="ExamDate"></label>
                <input asp-for="ExamDate"
                       type="date"
                       class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="ProgressPercentage"></label>
                <input asp-for="ProgressPercentage"
                       class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Status"></label>

                <select asp-for="Status"
                        class="form-select">

                    <option>Not Started</option>
                    <option>In Progress</option>
                    <option>Scheduled</option>
                    <option>Completed</option>

                </select>

            </div>

            <button type="submit"
                    class="btn btn-info">
                Save
            </button>

        </form>

    </div>

</div>