@model DevTrackAI.Models.Learning

<div class="card shadow">

    <div class="card-header bg-warning">
        <h3>Edit Course</h3>
    </div>

    <div class="card-body">

        <form asp-action="Edit">

            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="CourseName"></label>
                <input asp-for="CourseName"
                       class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Platform"></label>
                <input asp-for="Platform"
                       class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="ProgressPercentage"></label>
                <input asp-for="ProgressPercentage"
                       class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="HoursSpent"></label>
                <input asp-for="HoursSpent"
                       class="form-control" />
            </div>

            <button type="submit"
                    class="btn btn-success">
                Update
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>

</div>