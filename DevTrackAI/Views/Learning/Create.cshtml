@model DevTrackAI.Models.Learning

<h2>Add Course</h2>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label asp-for="CourseName"></label>
        <input asp-for="CourseName" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Platform"></label>
        <input asp-for="Platform" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="ProgressPercentage"></label>
        <input asp-for="ProgressPercentage" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="HoursSpent"></label>
        <input asp-for="HoursSpent" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">
        Save
    </button>

</form>