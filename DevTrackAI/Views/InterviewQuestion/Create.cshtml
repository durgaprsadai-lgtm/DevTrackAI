@model DevTrackAI.Models.InterviewQuestion

<div class="card shadow">

    <div class="card-header bg-dark text-white">
        <h3>Add Interview Question</h3>
    </div>

    <div class="card-body">

        <form asp-action="Create">

            <div class="mb-3">

                <label asp-for="Category"></label>

                <select asp-for="Category"
                        class="form-select">

                    <option>C#</option>
                    <option>ASP.NET Core</option>
                    <option>Entity Framework</option>
                    <option>Azure</option>
                    <option>Databricks</option>
                    <option>PySpark</option>

                </select>

            </div>

            <div class="mb-3">

                <label asp-for="Question"></label>

                <textarea asp-for="Question"
                          class="form-control">
                </textarea>

            </div>

            <div class="mb-3">

                <label asp-for="Difficulty"></label>

                <select asp-for="Difficulty"
                        class="form-select">

                    <option>Easy</option>
                    <option>Medium</option>
                    <option>Hard</option>

                </select>

            </div>

            <div class="mb-3">

                <label asp-for="Status"></label>

                <select asp-for="Status"
                        class="form-select">

                    <option>Pending</option>
                    <option>Learning</option>
                    <option>Completed</option>

                </select>

            </div>

            <div class="mb-3">

                <label asp-for="Notes"></label>

                <textarea asp-for="Notes"
                          class="form-control">
                </textarea>

            </div>

            <button class="btn btn-success">
                Save
            </button>

        </form>

    </div>

</div>