@model IEnumerable<DevTrackAI.Models.InterviewQuestion>

<div class="card shadow">

    <div class="card-header bg-dark text-white d-flex justify-content-between">

        <h3>Interview Question Tracker</h3>

        <a asp-action="Create"
           class="btn btn-light">
            Add Question
        </a>

    </div>

    <div class="card-body">

        <table class="table table-bordered">

            <thead class="table-dark">

                <tr>
                    <th>Category</th>
                    <th>Question</th>
                    <th>Difficulty</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>

            </thead>

            <tbody>

            @foreach(var item in Model)
            {
                <tr>

                    <td>@item.Category</td>

                    <td>@item.Question</td>

                    <td>@item.Difficulty</td>

                    <td>@item.Status</td>

                    <td>

                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-danger btn-sm">
                            Delete
                        </a>

                    </td>

                </tr>
            }

            </tbody>

        </table>

    </div>

</div>